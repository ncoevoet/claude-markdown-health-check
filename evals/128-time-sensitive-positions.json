{
  "id": "128-time-sensitive-positions",
  "command": "claude-markdown-health-check",
  "fixture": {
    "kind": "claude-tree",
    "dir": "tests/fixtures/time-sensitive-positions",
    "needs_home_override": false,
    "scanners": [
      "validate-skills"
    ]
  },
  "grader": {
    "method": "code"
  },
  "success_criteria": {
    "must_detect": [
      {
        "tag": "TIME-SENSITIVE",
        "path_substring": "after-details/SKILL.md: date-conditioned wording at line 9"
      },
      {
        "tag": "TIME-SENSITIVE",
        "path_substring": "old-patterns-end/SKILL.md: date-conditioned wording at line 14"
      },
      {
        "tag": "TIME-SENSITIVE",
        "path_substring": "prose-mention/SKILL.md: date-conditioned wording at line 9"
      },
      {
        "tag": "TIME-SENSITIVE",
        "path_substring": "legacy-free/SKILL.md: date-conditioned wording at line 10"
      },
      {
        "tag": "TIME-SENSITIVE",
        "path_substring": "mixed-fence/SKILL.md: date-conditioned wording at line 11"
      }
    ],
    "must_not_flag": [
      "WINDOWS-PATH"
    ],
    "expect_clean": false
  },
  "expected_behavior": [
    "a single-line <details>...</details> is skipped without hiding the dated prose line right after it",
    "an Old patterns section is exempt and ends at the next same-level heading, whose dated line is flagged",
    "prose that merely mentions `<details>` does not open a block",
    "'# Legacy-free design' is not a legacy heading: its section is still checked",
    "a lone ~~~ inside a ``` fence does not close it; the dated line after the real closing fence is flagged"
  ]
}
