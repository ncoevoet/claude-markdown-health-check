  "command": "markdown-health-check",
  "fixture": {
    "kind": "claude-tree",
    "dir": "tests/fixtures/mcp-dead-claude-dir-no-double",
    "needs_home_override": false,
    "scanners": ["scan-graph"]
  },
  "grader": { "method": "code" },
  "success_criteria": {
