{
  "id": "123-vague-name",
  "command": "markdown-health-check",
  "fixture": {
    "kind": "claude-tree",
    "dir": "tests/fixtures/vague-name",
    "needs_home_override": false,
    "scanners": [
      "validate-skills"
    ]
  },
  "grader": {
    "method": "code"
  },
  "success_criteria": {
    "must_detect": [
      {
        "tag": "VAGUE-NAME",
        "path_substring": "helper"
      },
      {
        "tag": "VAGUE-NAME",
        "path_substring": "doc2.md"
      },
      {
        "tag": "VAGUE-NAME",
        "path_substring": "files"
      },
      {
        "tag": "VAGUE-NAME",
        "path_substring": "File1.md"
      }
    ],
    "must_not_flag": [
      "RESERVED-WORD-PORTABILITY",
      "RESERVED-NAME"
    ],
    "expect_clean": false
  },
  "expected_behavior": [
    "validate-skills.sh emits [VAGUE-NAME] for a skill named with a bare generic word (helper, files)",
    "it also flags a reference file named doc<N>.md or file<N>.md",
    "the reference filename check is case-insensitive (File1.md)"
  ]
}
