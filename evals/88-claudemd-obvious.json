{
  "id": "88-claudemd-obvious",
  "command": "claude-markdown-health-check",
  "fixture": {
    "kind": "claude-tree",
    "dir": "tests/fixtures/claudemd-obvious",
    "needs_home_override": false,
    "scanners": ["validate-skills"]
  },
  "grader": { "method": "code" },
  "success_criteria": {
    "must_detect": [ { "tag": "CLAUDEMD-OBVIOUS", "path_substring": "CLAUDE.md" } ],
