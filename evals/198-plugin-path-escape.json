{
  "id": "198-plugin-path-escape",
  "command": "claude-markdown-health-check",
  "fixture": {
    "kind": "claude-tree",
    "dir": "tests/fixtures/plugin-path-escape",
    "needs_home_override": false,
    "scanners": ["scan-graph"]
  },
  "grader": { "method": "code" },
  "success_criteria": {
    "must_detect": [
      { "tag": "PLUGIN-PATH-ESCAPE", "path_substring": "../outside/a.md" },
      { "tag": "PLUGIN-PATH-ESCAPE", "path_substring": "/etc" },
      { "tag": "PLUGIN-PATH-ESCAPE", "path_substring": "./a/../../x" }
    ],
    "must_not_flag": [],
    "expect_clean": false
  },
  "expected_behavior": [
    "scan-graph.sh emits [PLUGIN-PATH-ESCAPE] for a `..` path, an absolute path outside the root, and `./a/../../x`, which starts with ./ but climbs out of the root"
  ]
}
